# Copy to .env and adjust.
ENVIRONMENT=development
DEBUG=true

# Demo defaults
DEFAULT_CITY=pune
DEFAULT_SCENARIO=clear

# Database (set to true to use Postgres/PostGIS)
DATABASE_ENABLED=true

# Infrastructure (used once DB/Celery are enabled)
DATABASE_URL=postgresql+asyncpg://mausam:mausam@localhost:5432/mausam
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Admin dashboard (credentials are env-driven, never hardcoded)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SECRET=changeme-2026
ADMIN_SESSION_HOURS=12

# CORS (secure default: empty = NO CORS middleware; browser calls blocked)
# Native mobile clients are unaffected by this setting.
# Set to a comma-separated list for the web preview / admin console.
MAUSAM_CORS_ORIGINS=

# Rate limiting (per-IP, /api/v1/auth/* only)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60