# Mausam mobile environment (loaded by Expo when prefixed EXPO_PUBLIC_).
# Copy to .env for local runs; set the real values via EAS secrets in CI.

# Backend URL used by the sync/auth flows. Replace with your real API base URL,
# e.g. https://api.example.com or http://10.0.2.2:8000 for Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Sentry crash reporting (optional). Leave unset to disable Sentry entirely.
EXPO_PUBLIC_SENTRY_DSN=
# Runtime environment tag surfaced to Sentry ("development" is the default).
EXPO_PUBLIC_APP_ENV=development
# Set to 1 for Maestro e2e: skips OS share choosers so in-app status is assertable.
EXPO_PUBLIC_E2E=