# Mausam mobile environment (loaded by Expo when prefixed EXPO_PUBLIC_).
# Copy to .env for local runs; set the real values via EAS secrets in CI.

# Sentry crash reporting (optional). Leave unset to disable Sentry entirely.
EXPO_PUBLIC_SENTRY_DSN=
# Runtime environment tag surfaced to Sentry ("development" is the default).
EXPO_PUBLIC_APP_ENV=development